{
  "name": "@capitalflow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @capitalflow/core",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "android:install-plugin": "node scripts/install-android-plugin.mjs",
    "android:sync": "npm run build && cap sync android",
    "prebuild": "node --experimental-strip-types scripts/write-static-security-headers.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capitalflow/core": "0.1.0",
    "@supabase/supabase-js": "^2.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
