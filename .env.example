# Web
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Legacy projects may expose an anon key instead. Do not set both unless needed.
VITE_SUPABASE_ANON_KEY=
VITE_FUNCTIONS_BASE_URL=
VITE_APP_URL=http://localhost:5173
VITE_DEV_BYPASS_SUBSCRIPTION=false

# Supabase Edge Functions
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
APP_URL=http://localhost:5173

# OAuth token encryption: 32 random bytes, base64 encoded
OAUTH_TOKEN_ENCRYPTION_KEY_B64=
OAUTH_STATE_SECRET=

# Google / Gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/gmail-oauth-callback
GMAIL_PUBSUB_TOPIC=projects/YOUR_PROJECT/topics/capitalflow-gmail
GMAIL_PUBSUB_AUDIENCE=
# Optional additional OIDC claim pinning for authenticated Pub/Sub push.
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Fallback only when GMAIL_PUBSUB_AUDIENCE is empty (local/sandbox).
GMAIL_PUBSUB_TOKEN=

# Microsoft / Outlook
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/outlook-oauth-callback
MICROSOFT_TENANT=common
OUTLOOK_WEBHOOK_URL=https://YOUR_PROJECT.supabase.co/functions/v1/outlook-webhook
OUTLOOK_CLIENT_STATE=


# Annual cloud backup OAuth (Google Drive appDataFolder / OneDrive App Folder)
# Register this exact callback URL in both Google OAuth and Microsoft Entra.
STORAGE_OAUTH_REDIRECT_URI=https://YOUR_PROJECT.supabase.co/functions/v1/storage-oauth-callback

# Whop
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
WHOP_WEEKLY_PLAN_ID=
WHOP_ANNUAL_PLAN_ID=
WHOP_API_VERSION_DATE=2026-08-10
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1

# Scheduled Edge Functions
CRON_SECRET=

# Optional AI gateway. The deterministic advisor works without these.
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
AI_MODEL=
